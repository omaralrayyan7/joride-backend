# E8.3 note: two different naming conventions are in play below, and they are NOT
# interchangeable — verified against how each config value is actually read in code
# (grep the flat names below across JoRideBackend/ if you want to re-check this yourself):
#
#   - Flat names (POSTGRES_CONNECTION_STRING, TRACCAR_*, HYPERPAY_*,
#     KYC_DOCUMENT_SIGNING_SECRET) are read directly via `configuration["THAT_EXACT_NAME"]`
#     in Program.cs/the relevant service — set them exactly as shown.
#   - Jwt/Firebase/Twilio/Smtp are read via ASP.NET Core's hierarchical config binding
#     (e.g. `configuration.GetSection("Jwt")`, `config["Firebase:ProjectId"]`), which maps
#     environment variables using a DOUBLE UNDERSCORE as the section separator — so the env
#     var must be named e.g. `Jwt__Key`, not `JWT_KEY`. A single-underscore/flat name for
#     these specific keys is silently ignored and the app falls back to the placeholder
#     value baked into appsettings.json, which is a real, easy-to-miss production risk
#     (found while building E8.3's deployment config — this file previously listed the
#     wrong, non-functional flat names for exactly these keys).

JWT__KEY=replace_with_32_char_random_hs256_key
FIREBASE__PROJECTID=joride-e049b
FIREBASE__CREDENTIALSPATH=/secure/path/joride-e049b-firebase-adminsdk-fbsvc.json
TWILIO__ACCOUNTSID=
TWILIO__AUTHTOKEN=
TWILIO__FROMPHONENUMBER=
SMTP__HOST=smtp.gmail.com
SMTP__PORT=587
SMTP__USER=
SMTP__PASSWORD=

TRACCAR_BASE_URL=http://localhost:8083
TRACCAR_TOKEN=
TRACCAR_WEBHOOK_SECRET=replace_with_a_random_shared_secret
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=joride;Username=joride;Password=replace_me
HYPERPAY_BASE_URL=https://eu-test.oppwa.com
HYPERPAY_ENTITY_ID=
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_WEBHOOK_SECRET=
KYC_DOCUMENT_SIGNING_SECRET=replace_with_a_random_shared_secret
