diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..620dc25
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,35 @@
+name: CI
+
+on:
+  push:
+    branches: [main, master]
+  pull_request:
+    branches: [main, master]
+
+jobs:
+  build-and-test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Setup .NET
+        uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: '8.0.x'
+
+      - name: Restore
+        run: dotnet restore JoRideBackend.sln
+
+      - name: Build
+        run: dotnet build JoRideBackend.sln --no-restore --configuration Release
+
+      - name: Test
+        run: dotnet test JoRideBackend.sln --no-build --configuration Release --verbosity normal
+        continue-on-error: true
+        # continue-on-error kept until a test project exists (E0 has no tests yet);
+        # remove this line once tests/ is added so CI actually gates PRs.
+
+      - name: Secret scan (gitleaks)
+        uses: gitleaks/gitleaks-action@v2
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
